# AgentSentry Environment Configuration Template
# Copy this file to backend/.env and add your Groq API key (free at https://console.groq.com/keys)

PORT=3001
GROQ_API_KEY=your_groq_api_key_here

# Model Selection (defaults to high-performance open models on Groq)
AGENT_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b
GUARD_MODEL=meta-llama/llama-prompt-guard-2-22m
